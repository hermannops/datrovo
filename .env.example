# Variables lues par docker-compose.yml. Copier en .env et ajuster pour la prod
# (mots de passe forts, domaine réel) — ne jamais committer le .env rempli.

POSTGRES_USER=datrovo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=datrovo
POSTGRES_PORT=5432

BACKEND_PORT=8000
CRM_DISPATCH_TIMEOUT_SECONDS=5.0
LEAD_DEDUP_WINDOW_DAYS=30
REPRISE_DEFAULT_DEALER_ID=1

FRONTEND_PORT=3000
SITE_URL=https://www.datrovo.fr
