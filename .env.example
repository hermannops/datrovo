# Variables lues par docker-compose.yml. Copier en .env et ajuster pour la prod
# (mots de passe forts, domaine réel) — ne jamais committer le .env rempli.

POSTGRES_USER=datrovo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=datrovo
POSTGRES_PORT=5432

BACKEND_PORT=8000
CRM_DISPATCH_TIMEOUT_SECONDS=5.0
LEAD_DEDUP_WINDOW_DAYS=30
REPRISE_DEFAULT_DEALER_ID=1

FRONTEND_PORT=3000
# Staging derrière Tailscale : IP tailnet du host ou nom MagicDNS, PAS une
# URL publique tant que le DNS/HTTPS réels ne sont pas en place.
# Ex: http://100.64.12.34:3000  ou  http://datrovo-staging.tailxxxxx.ts.net:3000
SITE_URL=http://100.x.x.x:3000
